{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DAY2: 패키지 설치 (최초 1회)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "DAY2: 전체 분석 실행",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["main.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
